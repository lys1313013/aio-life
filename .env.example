# AIO Life 环境变量示例
# 复制为 .env 并按实际情况修改，.env 已被 gitignore，不会提交到仓库
# docker-compose 会自动读取同目录下的 .env 文件

# ============ 数据库 (MySQL) ============
AIO_LIFE_DB_URL=127.0.0.1:3306
AIO_LIFE_DB_PASSWORD=root

# ============ Redis ============
AIO_LIFE_REDIS_HOST=127.0.0.1
AIO_LIFE_REDIS_PORT=6379
AIO_LIFE_REDIS_PASSWORD=

# ============ MinIO 对象存储 ============
AIO_LIFE_MINIO_ENDPOINT=http://localhost:1300
AIO_LIFE_MINIO_ACCESS_KEY=aio_life
AIO_LIFE_MINIO_SECRET_KEY=aio_life
AIO_LIFE_MINIO_BUCKET_NAME=aiolife

# ============ 邮件（登录验证码） ============
AIO_LIFE_MAIL_USERNAME=test@qq.com
AIO_LIFE_MAIL_PASSWORD=password

# ============ 通知渠道密钥 ============
# 至少 16 位，用于加密每个用户的飞书 App Secret 和通知重试载荷
AIO_LIFE_NOTIFICATION_ENCRYPTION_KEY=replace-with-a-strong-random-secret

# ============ Neo4j（人际关系图谱，可选） ============
AIO_LIFE_NEO4J_ENABLED=false
AIO_LIFE_NEO4J_URI=bolt://localhost:7687
# AIO_LIFE_NEO4J_USERNAME=neo4j
# AIO_LIFE_NEO4J_PASSWORD=neo4j123456

# ============ 其他（后端本地运行时可用） ============
# 定时任务总开关
# AIO_LIFE_SCHEDULING_ENABLED=true
# 服务对外地址
# AIO_LIFE_SERVER_BASE_URL=http://localhost:45678/api
# MBTI 测评 API
# AIO_LIFE_MBTI_API_KEY=
# AIO_LIFE_MBTI_BASE_URL=https://api.devil.ai
