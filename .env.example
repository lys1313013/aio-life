# AIO Life 环境变量示例
# 复制为 .env 并按实际情况修改，.env 已被 gitignore，不会提交到仓库
# docker-compose 会自动读取同目录下的 .env 文件

# ============ 数据库 (PostgreSQL 18+) ============
AIO_LIFE_DB_URL=127.0.0.1:5432
AIO_LIFE_DB_NAME=aio_life
AIO_LIFE_DB_USERNAME=aio_life
AIO_LIFE_DB_PASSWORD=replace-with-a-strong-password
AIO_LIFE_DB_SSLMODE=prefer

# ============ Redis ============
AIO_LIFE_REDIS_HOST=127.0.0.1
AIO_LIFE_REDIS_PORT=6379
AIO_LIFE_REDIS_PASSWORD=

# ============ MinIO 对象存储 ============
AIO_LIFE_MINIO_ENDPOINT=http://localhost:1300
AIO_LIFE_MINIO_ACCESS_KEY=aio_life
AIO_LIFE_MINIO_SECRET_KEY=aio_life
AIO_LIFE_MINIO_BUCKET_NAME=aiolife

# ============ 邮件（登录验证码） ============
AIO_LIFE_MAIL_USERNAME=test@qq.com
AIO_LIFE_MAIL_PASSWORD=password

# ============ 通知渠道密钥 ============
# 至少 16 位，用于加密每个用户的飞书 App Secret 和通知重试载荷
AIO_LIFE_NOTIFICATION_ENCRYPTION_KEY=replace-with-a-strong-random-secret

# ============ Neo4j（人际关系图谱，可选） ============
AIO_LIFE_NEO4J_ENABLED=false
AIO_LIFE_NEO4J_URI=bolt://localhost:7687
# AIO_LIFE_NEO4J_USERNAME=neo4j
# AIO_LIFE_NEO4J_PASSWORD=neo4j123456

# ============ 其他（后端本地运行时可用） ============
# 定时任务总开关
# AIO_LIFE_SCHEDULING_ENABLED=true
# 服务对外地址（注意 SERVER 拼写；部署时必须改为公网 HTTPS，如 https://aiolife.top/api）
# AIO_LIFE_SERVER_BASE_URL=http://localhost:45678/api
# MBTI 测评 API
# AIO_LIFE_MBTI_API_KEY=
# AIO_LIFE_MBTI_BASE_URL=https://api.devil.ai

# ============ 银行卡（单一32字节Base64主密钥，SM4-GCM） ============
# 运行一次 openssl rand -base64 32 生成；程序派生SM4和判重子密钥，不要将真实密钥提交到仓库。
# 未配置时仍可启动服务，但银行卡新增和完整卡号读取将拒绝执行。
AIO_LIFE_BANK_CARD_ENCRYPTION_KEY=

# ============ 微信小程序及 Web 扫码登录 ============
AIO_LIFE_WECHAT_MINI_ENABLED=false
AIO_LIFE_WECHAT_MINI_APP_ID=
AIO_LIFE_WECHAT_MINI_APP_SECRET=
# pages/auth/web-login 正式发布后再开启；无需手机号权限
AIO_LIFE_WECHAT_WEB_SCAN_ENABLED=false
AIO_LIFE_WECHAT_WEB_SCAN_ENV_VERSION=release

# ============ 生活足迹地图（百度） ============
# 服务端 AK 和可替换底图在管理员「系统配置 → 生活足迹地图」维护，保存至 sys_config。
# Web/H5 使用前端开源地图组件，不再需要百度浏览器端 AK。
# 服务端 AK 加密沿用上方 AIO_LIFE_NOTIFICATION_ENCRYPTION_KEY，不下发客户端。
AIO_LIFE_MAP_TIMEOUT_MS=5000

# ============ 独立 Query（docker-compose-query.yml，按需启用） ============
# 将下列配置取消注释并填入实际值；每个密钥分别用 openssl rand -hex 32 生成。
# 后端启用查询鉴权；目标自动进度通过共享 aio-life 网络访问网关。
# AIO_LIFE_QUERY_ACCESS_ENABLED=true
# AIO_LIFE_QUERY_ACCESS_SERVICE_KEY=
# AIO_LIFE_GOAL_QUERY_URL=http://aio-life-query:45680/graphql
# 网关服务密钥必须与后端一致，其余密钥分别生成，不复用。
# AIO_QUERY_SERVICE_KEY=${AIO_LIFE_QUERY_ACCESS_SERVICE_KEY}
# AIO_QUERY_WEBHOOK_KEY=
# AIO_QUERY_CONNECTOR_KEY=
# 默认复用上方 AIO_LIFE_REDIS_HOST/PORT/PASSWORD，不新建 Redis 实例。
# 仅需要覆盖连接地址时填写，主机地址须能从 aio-life-query 容器访问。
# AIO_QUERY_REDIS_HOST=redis-host
# AIO_QUERY_REDIS_PORT=6379
# AIO_QUERY_REDIS_PASSWORD=
# Hasura 必须为配套的 v3 引擎，不能替换成 v2 graphql-engine 镜像。
# AIO_QUERY_ENGINE_IMAGE=
# AIO_QUERY_CONNECTOR_IMAGE=aio-life-query-postgresql-connector:local
# 网关默认拉取与业务后端相同 ACR 命名空间中的 aio-life-query:latest。
# AIO_QUERY_GATEWAY_IMAGE=
# 使用专用列级 SELECT 账号，地址必须能从 Connector 容器访问。
# AIO_QUERY_JDBC_URL=jdbc:postgresql://db-host:5432/aio_life?user=aio_query_readonly&password=replace-me&sslmode=require
# 填写生成元数据账号的 id -g 输出；元数据目录默认是下方路径。
# AIO_QUERY_CONFIG_GID=
# AIO_QUERY_METADATA_DIRECTORY=./aio-life-query/.cache/hasura
# 同主 Compose 部署时保留默认值；跨主机需改为实际内网鉴权 URL。
# AIO_QUERY_ACCESS_URL=http://backend:45678/api/internal/query/access/check-token
# Hasura 可单独启动或部署；地址须能从 aio-life-query 容器访问。
# AIO_QUERY_HASURA_URL=http://hasura:3000/graphql
# AIO_QUERY_BACKEND_NETWORK=aio-life
# 仅浏览器 MCP 接入需要填写，逗号分隔的精确可信 Origin。
# AIO_QUERY_MCP_ALLOWED_ORIGINS=
